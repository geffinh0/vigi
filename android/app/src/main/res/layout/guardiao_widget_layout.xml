<?xml version="1.0" encoding="utf-8"?>
<!-- Widget 2x2 do Vigi (Guia de Design, seção 12).

     Mostra a coruja no estado atual e o horário do próximo check-in. Quando
     é a vez da pessoa, o widget inteiro vira um botão âmbar de toque único.
     O conteúdo de cada estado é definido em GuardiaoWidgetProvider.kt.

     Não há botão de pânico aqui: pedir ajuda exige segurar por 3 segundos,
     o que um widget não consegue garantir. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clickable="true"
    android:focusable="true"
    android:padding="12dp">

    <!-- Coruja e textos formam um bloco só, centralizado no widget. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- Com peso, a coruja é a primeira a ceder: num widget apertado (ou
             com a fonte do sistema grande) ela encolhe e o texto continua
             inteiro. Com espaço, fica no tamanho natural de 64 dp. -->
        <ImageView
            android:id="@+id/widget_icon"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:adjustViewBounds="true"
            android:importantForAccessibility="no"
            android:maxWidth="64dp"
            android:maxHeight="64dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_vigi_descansando" />

        <TextView
            android:id="@+id/widget_time"
            style="@style/VigiWidgetTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:maxLines="2"
            android:text="@string/widget_resting_title"
            android:textColor="@color/vigi_petroleo_800" />

        <TextView
            android:id="@+id/widget_status"
            style="@style/VigiWidgetCaption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:maxLines="2"
            android:text="@string/widget_open_subtitle"
            android:textColor="@color/vigi_cinza_texto" />

    </LinearLayout>
</FrameLayout>
